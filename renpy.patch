+class SwitchZipAPK(object):
+    """
+    Switch: a stand-in for android.apk.APK that reads a Ren'Py game out of a .zip
+    or .apk sitting on the SD card, so the loader can serve the game's files on the
+    fly (no extraction).
+
+    `prefix` is the path inside the archive to the game root, e.g. "assets/x-game/"
+    for an Android build or "MyGame-1.0-pc/game/" for a desktop zip. Names returned
+    by list() and passed to open() are relative to that prefix (so they still carry
+    the per-component "x-" for an .apk, which the loader strips/adds as needed).
+    """
+
+    def __init__(self, path, prefix=""):
+        self.path = path
+        self.prefix = prefix
+        self.zf = zipfile.ZipFile(path, "r")
+
+        # archive-relative name (prefix stripped) -> ZipInfo
+        self.entries = {}
+        plen = len(prefix)
+        for zi in self.zf.infolist():
+            name = zi.filename
+            if name.endswith("/"):
+                continue
+            if prefix and not name.startswith(prefix):
+                continue
+            self.entries[name[plen:]] = zi
+
+    def list(self):
+        return list(self.entries)
+
+    def _data_offset(self, zi):
+        # The data starts after the LOCAL file header, whose name/extra lengths can
+        # differ from the central directory's, so read the local header to be exact.
+        with open(self.path, "rb") as f:
+            f.seek(zi.header_offset)
+            hdr = f.read(30)
+        name_len = struct.unpack("<H", hdr[26:28])[0]
+        extra_len = struct.unpack("<H", hdr[28:30])[0]
+        return zi.header_offset + 30 + name_len + extra_len
+
+    def open(self, name):
+        zi = self.entries.get(name)
+        if zi is None:
+            raise IOError("not in archive: " + name)
+
+        if zi.compress_type == zipfile.ZIP_STORED:
+            # Uncompressed (the case for Android .apk assets): hand back a seekable
+            # window straight into the archive file — no decompression, low memory,
+            # the same trick Ren'Py uses to read .rpa archives.
+            off = self._data_offset(zi)
+            return io.BufferedReader(RWopsIO(self.path, "rb", base=off, length=zi.file_size))
+
+        # Compressed (typical desktop .zip): decompress the whole entry into memory,
+        # which is seekable. (Larger files pay a RAM cost here; see the loose-file
+        # v1 note. Repacking a game's zip as "stored" avoids it.)
+        data = self.zf.read(zi)
+        return io.BufferedReader(RWopsIO.from_buffer(data, name=name))
+
