+            for zi in zf.infolist():
+                dt = zi.date_time
+                if dt[0] < 1980:
+                    continue
+                t = time.mktime((dt[0], dt[1], dt[2], dt[3], dt[4], dt[5], 0, 0, -1))
+                if t > best:
+                    best = t
+            return best
