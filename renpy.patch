+# Switch port stub for renpy.gl2.assimp.
+#
+# The real module is a Cython extension wrapping libassimp (3D / glTF model
+# loading), which has no backend on the Switch and is excluded from the build.
+# This pure-Python stub provides the public names the rest of the engine
+# references so import_all(), defaultstore, and the per-frame display loop work.
+# Actually loading a 3D model raises NotImplementedError.
+
+import threading
+
+# Referenced by renpy.__init__.Backup's skip-set and the loader machinery.
+loader = None
+loader_lock = threading.RLock()
+
+
+def free_memory():
+    """Called from the display core each frame; nothing to free here."""
+    return
+
+
+def preload():
+    """Called from renpy.display.im; no assimp assets to preload."""
+    return
+
+
+def finish_predict():
+    """Called from renpy.display.predict; nothing to finish."""
+    return
+
+
+class GLTFModel(object):
+    """
+    Exposed to the creator-facing store as GLTFModel. Instantiating it means a
+    game is trying to use a 3D model, which the Switch port does not support.
+    """
+
+    def __init__(self, *args, **kwargs):
+        raise NotImplementedError(
+            "3D models (assimp / glTF) are not supported on the Switch port of Ren'Py."
+        )
