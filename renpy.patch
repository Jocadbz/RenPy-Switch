+    """
+    The Switch savedata filesystem does not record per-file modification times
+    (os.path.getmtime always returns 0 there), so recover a save's time from the
+    timestamp Python's zipfile stamps into each member when the save is written
+    (writestr uses the current local time). Returns a POSIX timestamp, or 0.
+    """
+    try:
+        import zipfile
+        with zipfile.ZipFile(path, "r") as zf:
